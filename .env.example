# CodeCycle Docker Compose 环境变量模板
# 复制为 .env 并修改密码后使用：docker compose --env-file .env up -d

# 项目
COMPOSE_PROJECT_NAME=codecycle
TZ=Asia/Shanghai

# PostgreSQL + pgvector
POSTGRES_DB=codecycle
POSTGRES_USER=codecycle
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# Nacos（单机）
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_JVM_XMX=512m
NACOS_AUTH_ENABLE=false

# Redis（仅 MCP Token 运行时状态）
REDIS_PORT=6379
REDIS_PASSWORD=123456

# MinIO（对象存储：头像/图片/导入导出文件）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=codecycle
MINIO_ROOT_PASSWORD=12345678

# 访问地址（Windows 宿主访问 VM 中间件）
# PostgreSQL: 192.168.80.125:5432 / Redis: 192.168.80.125:6379
# Nacos: http://192.168.80.125:8848
# MinIO API: http://192.168.80.125:9000  控制台: http://192.168.80.125:9001

# Windows 宿主 Java 服务开发配置（application-dev.yml 可直接使用默认值）
NACOS_ADDR=192.168.80.125:8848
POSTGRES_HOST=192.168.80.125
REDIS_HOST=192.168.80.125
MINIO_ENDPOINT=http://192.168.80.125:9000
CODECYCLE_INTERNAL_SERVICE_TOKEN=请替换为至少32字节随机值
